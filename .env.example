# Slack tokens — get these from api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Slack channel ID for EX team admin reports (right-click channel → Copy Link → last segment)
ADMIN_CHANNEL_ID=C...

# Calendly link sent to matched employees for scheduling
CALENDLY_LINK=https://calendly.com/your-link-here

# Database path — leave blank for local dev (creates brewbot.db in project folder)
# Railway/Docker sets this automatically to /data/brewbot.db via the Dockerfile
# DB_PATH=/data/brewbot.db

# Cycle configuration
CYCLE_DURATION_DAYS=14
# Cron expression for when matching runs (default: every other Monday at 9am)
CYCLE_START_CRON=0 9 * * MON
# Cron for the per-round opt-in prompt, sent ahead of the cycle (default: Friday 9am)
ROUND_OPTIN_CRON=0 9 * * FRI

# AwardCo SFTP reward drop — leave blank to fall back to manual issuance via admin channel
AWARDCO_SFTP_HOST=sftp.awardco.com
AWARDCO_SFTP_USER=crowdstrike
AWARDCO_SFTP_KEY=path/to/private_key
AWARDCO_PROGRAM_ID=CROWDBREW_EARN
